# Optional: Configure an OpenAI API key or Gemini API key for dynamic AI responses.
# If not provided, the portfolio automatically operates in intelligent zero-dependency fallback mode.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Public application URL
NEXT_PUBLIC_SITE_URL=https://vijay-portfolio18.netlify.app

# Contact Form Email Service (Optional for direct API dispatch; Netlify Forms handles inbox notifications natively)
# Set the real destination address as a Netlify environment variable, not in this file
CONTACT_DESTINATION_EMAIL=your-destination-email@example.com
RESEND_API_KEY=
FROM_EMAIL=your-from-email@example.com
